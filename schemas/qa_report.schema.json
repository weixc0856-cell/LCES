{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "gate": {
          "enum": [
            "gate_1_research",
            "gate_2_content",
            "gate_3_engineering",
            "gate_4_release"
          ],
          "title": "Gate",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "gate",
        "status",
        "message"
      ],
      "title": "CheckResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "provider": {
      "default": "",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "QAReport",
  "type": "object"
}
