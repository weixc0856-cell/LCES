{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ResearchFinding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "limitations": {
          "default": "",
          "title": "Limitations",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "statement"
      ],
      "title": "ResearchFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "research_question": {
      "title": "Research Question",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ResearchFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "source_conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Source Conflicts",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "research_question",
    "scope"
  ],
  "title": "ResearchBrief",
  "type": "object"
}
