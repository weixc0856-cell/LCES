{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^evidence-[0-9]{3,}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "chunk_id": {
          "default": "",
          "title": "Chunk Id",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "quote",
            "data",
            "figure",
            "table",
            "formula",
            "experiment",
            "official_statement",
            "analysis"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "source_excerpt": {
          "default": "",
          "maxLength": 2000,
          "title": "Source Excerpt",
          "type": "string"
        },
        "support_relation": {
          "enum": [
            "supports",
            "refutes",
            "partially_supports",
            "background"
          ],
          "title": "Support Relation",
          "type": "string"
        },
        "verification_status": {
          "default": "unverified",
          "enum": [
            "pending",
            "supported",
            "partially_supported",
            "contradicted",
            "insufficient_evidence",
            "not_applicable",
            "unverified",
            "verified",
            "conflict",
            "unverifiable"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "quote_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "verified_exact",
            "verified_normalized",
            "verified_structured"
          ],
          "title": "Quote Status",
          "type": "string"
        },
        "formula": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormulaEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewer": {
          "default": "",
          "title": "Reviewer",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "claim_id",
        "evidence_type",
        "support_relation"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "FormulaEvidence": {
      "additionalProperties": false,
      "description": "A formula proposed as evidence.\n\nThe program can check the paper element, locator and symbol presence. It\ncannot prove the algebra, so a formula never becomes ``verified_exact``.",
      "properties": {
        "formula_id": {
          "default": "",
          "title": "Formula Id",
          "type": "string"
        },
        "expression": {
          "default": "",
          "title": "Expression",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        }
      },
      "title": "FormulaEvidence",
      "type": "object"
    },
    "TableEvidence": {
      "additionalProperties": false,
      "description": "One table cell/row proposed as evidence.",
      "properties": {
        "scope": {
          "default": "row",
          "enum": [
            "cell",
            "row",
            "prose"
          ],
          "title": "Scope",
          "type": "string"
        },
        "table_id": {
          "default": "",
          "title": "Table Id",
          "type": "string"
        },
        "row_label": {
          "default": "",
          "title": "Row Label",
          "type": "string"
        },
        "column_label": {
          "default": "",
          "title": "Column Label",
          "type": "string"
        },
        "value": {
          "default": "",
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "variant": {
          "default": "",
          "title": "Variant",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        }
      },
      "title": "TableEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "EvidenceLedger",
  "type": "object"
}
