{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "scope": {
          "default": "release",
          "title": "Scope",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "version",
        "approved_by"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "ManifestFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ManifestFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Version binding for a published course package.\n\n``manifest_schema_version`` 2.0 records the lineage SAD-001 §9.2 requires:\nwhich course contract, build fingerprint, code revision, source registry,\nGate B report and human acceptance the decision was made against.\nVersion 1.0 manifests (all releases built before 2026-10-24) stay readable\nand are verified with the older, weaker rule set.",
  "properties": {
    "manifest_schema_version": {
      "default": "1.0",
      "title": "Manifest Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "package_version": {
      "title": "Package Version",
      "type": "string"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "provider": {
      "default": "",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "content_sha256": {
      "default": "",
      "title": "Content Sha256",
      "type": "string"
    },
    "gates": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Gates",
      "type": "object"
    },
    "human_approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ManifestFile"
      },
      "title": "Files",
      "type": "array"
    },
    "course_version": {
      "default": "",
      "title": "Course Version",
      "type": "string"
    },
    "content_version": {
      "default": "",
      "title": "Content Version",
      "type": "string"
    },
    "code_version": {
      "default": "",
      "title": "Code Version",
      "type": "string"
    },
    "input_sha256": {
      "default": "",
      "title": "Input Sha256",
      "type": "string"
    },
    "quality_sha256": {
      "default": "",
      "title": "Quality Sha256",
      "type": "string"
    },
    "acceptance_sha256": {
      "default": "",
      "title": "Acceptance Sha256",
      "type": "string"
    },
    "course_product": {
      "default": "",
      "title": "Course Product",
      "type": "string"
    },
    "decision": {
      "default": "",
      "title": "Decision",
      "type": "string"
    },
    "disclosures": {
      "items": {
        "type": "string"
      },
      "title": "Disclosures",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "version",
    "package_version",
    "python_version"
  ],
  "title": "ReleaseManifest",
  "type": "object"
}
