{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CourseModule": {
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "pattern": "^module-[a-z0-9.-]+$",
          "title": "Module Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "target_minutes": {
          "exclusiveMinimum": 0,
          "title": "Target Minutes",
          "type": "number"
        },
        "slide_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Slide Ids",
          "type": "array"
        }
      },
      "required": [
        "module_id",
        "title",
        "target_minutes",
        "slide_ids"
      ],
      "title": "CourseModule",
      "type": "object"
    },
    "CourseObjective": {
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "pattern": "^objective-[a-z0-9.-]+$",
          "title": "Objective Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "slide_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Slide Ids",
          "type": "array"
        }
      },
      "required": [
        "objective_id",
        "statement",
        "slide_ids"
      ],
      "title": "CourseObjective",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "version": {
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "approved"
      ],
      "title": "Status",
      "type": "string"
    },
    "approved_by": {
      "default": "",
      "title": "Approved By",
      "type": "string"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "audience": {
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "prerequisites": {
      "items": {
        "type": "string"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "target_duration_minutes": {
      "exclusiveMinimum": 0,
      "title": "Target Duration Minutes",
      "type": "number"
    },
    "timing_rule": {
      "minLength": 1,
      "title": "Timing Rule",
      "type": "string"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/CourseObjective"
      },
      "minItems": 1,
      "title": "Objectives",
      "type": "array"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/CourseModule"
      },
      "minItems": 1,
      "title": "Modules",
      "type": "array"
    },
    "deliverables": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Deliverables",
      "type": "array"
    },
    "required_formula_count": {
      "default": 3,
      "minimum": 0,
      "title": "Required Formula Count",
      "type": "integer"
    },
    "required_check_count": {
      "default": 6,
      "minimum": 0,
      "title": "Required Check Count",
      "type": "integer"
    },
    "manual_items": {
      "items": {
        "type": "string"
      },
      "title": "Manual Items",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "audience",
    "target_duration_minutes",
    "timing_rule",
    "objectives",
    "modules",
    "deliverables"
  ],
  "title": "CourseContract",
  "type": "object"
}
