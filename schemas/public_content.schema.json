{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BulletsBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bullets",
          "default": "bullets",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "BulletsBlock",
      "type": "object"
    },
    "CalloutBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "callout",
          "default": "callout",
          "title": "Type",
          "type": "string"
        },
        "kind": {
          "default": "note",
          "enum": [
            "note",
            "warning",
            "limitation",
            "assumption"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CalloutBlock",
      "type": "object"
    },
    "ChartBlock": {
      "additionalProperties": false,
      "description": "A statistical chart described by data plus a Vega-Lite spec.\n\nThe rendered SVG is derived at build time; the block carries no markup.",
      "properties": {
        "type": {
          "const": "chart",
          "default": "chart",
          "title": "Type",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "alt": {
          "minLength": 1,
          "title": "Alt",
          "type": "string"
        },
        "spec": {
          "additionalProperties": true,
          "title": "Spec",
          "type": "object"
        }
      },
      "required": [
        "alt"
      ],
      "title": "ChartBlock",
      "type": "object"
    },
    "CodeBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "code",
          "default": "code",
          "title": "Type",
          "type": "string"
        },
        "language": {
          "default": "text",
          "title": "Language",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "CodeBlock",
      "type": "object"
    },
    "FigureBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "figure",
          "default": "figure",
          "title": "Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "alt": {
          "minLength": 1,
          "title": "Alt",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        }
      },
      "required": [
        "path",
        "alt"
      ],
      "title": "FigureBlock",
      "type": "object"
    },
    "FormulaBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "formula",
          "default": "formula",
          "title": "Type",
          "type": "string"
        },
        "latex": {
          "minLength": 1,
          "title": "Latex",
          "type": "string"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "latex"
      ],
      "title": "FormulaBlock",
      "type": "object"
    },
    "ParagraphBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "paragraph",
          "default": "paragraph",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ParagraphBlock",
      "type": "object"
    },
    "PublicSlide": {
      "additionalProperties": false,
      "properties": {
        "slide_id": {
          "pattern": "^slide-[0-9]{3,}$",
          "title": "Slide Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "body": {
          "items": {
            "discriminator": {
              "mapping": {
                "bullets": "#/$defs/BulletsBlock",
                "callout": "#/$defs/CalloutBlock",
                "chart": "#/$defs/ChartBlock",
                "code": "#/$defs/CodeBlock",
                "figure": "#/$defs/FigureBlock",
                "formula": "#/$defs/FormulaBlock",
                "paragraph": "#/$defs/ParagraphBlock",
                "quote": "#/$defs/QuoteBlock",
                "table": "#/$defs/TableBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ParagraphBlock"
              },
              {
                "$ref": "#/$defs/BulletsBlock"
              },
              {
                "$ref": "#/$defs/FormulaBlock"
              },
              {
                "$ref": "#/$defs/CodeBlock"
              },
              {
                "$ref": "#/$defs/FigureBlock"
              },
              {
                "$ref": "#/$defs/TableBlock"
              },
              {
                "$ref": "#/$defs/ChartBlock"
              },
              {
                "$ref": "#/$defs/CalloutBlock"
              },
              {
                "$ref": "#/$defs/QuoteBlock"
              }
            ]
          },
          "minItems": 1,
          "title": "Body",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "slide_id",
        "title",
        "body"
      ],
      "title": "PublicSlide",
      "type": "object"
    },
    "QuoteBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "quote",
          "default": "quote",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "QuoteBlock",
      "type": "object"
    },
    "TableBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table",
          "default": "table",
          "title": "Type",
          "type": "string"
        },
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "title": "TableBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public-only model. Never add speaker notes or internal QA fields here.",
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "subtitle": {
      "default": "",
      "title": "Subtitle",
      "type": "string"
    },
    "language": {
      "default": "zh-CN",
      "title": "Language",
      "type": "string"
    },
    "audience": {
      "default": "",
      "title": "Audience",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/PublicSlide"
      },
      "minItems": 1,
      "title": "Slides",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "title",
    "slides"
  ],
  "title": "PublicContent",
  "type": "object"
}
