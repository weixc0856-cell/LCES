{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "QualityFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "human"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "check_id",
        "severity",
        "message"
      ],
      "title": "QualityFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "audit_id": {
      "title": "Audit Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "contract_version": {
      "default": "",
      "title": "Contract Version",
      "type": "string"
    },
    "content_version": {
      "default": "",
      "title": "Content Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "files": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Files",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/QualityFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Summary",
      "type": "object"
    },
    "decision": {
      "default": "not_run",
      "enum": [
        "passed",
        "needs_human_review",
        "blocked",
        "not_run"
      ],
      "title": "Decision",
      "type": "string"
    },
    "production_decision": {
      "default": "not_run",
      "enum": [
        "passed",
        "needs_human_review",
        "blocked",
        "not_run"
      ],
      "title": "Production Decision",
      "type": "string"
    },
    "disclosures": {
      "items": {
        "type": "string"
      },
      "title": "Disclosures",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "audit_id",
    "project_id",
    "generated_at"
  ],
  "title": "CourseQualityReport",
  "type": "object"
}
