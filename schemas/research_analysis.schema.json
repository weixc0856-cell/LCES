{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^claim-[0-9]{3,}$",
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "fact",
            "inference",
            "assumption",
            "unknown",
            "disputed"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "importance": {
          "default": "supporting",
          "enum": [
            "key",
            "supporting"
          ],
          "title": "Importance",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "statement",
        "claim_type"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^evidence-[0-9]{3,}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "quote",
            "data",
            "figure",
            "table",
            "experiment",
            "official_statement",
            "analysis"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "locator": {
          "default": "",
          "title": "Locator",
          "type": "string"
        },
        "source_excerpt": {
          "default": "",
          "maxLength": 2000,
          "title": "Source Excerpt",
          "type": "string"
        },
        "support_relation": {
          "enum": [
            "supports",
            "refutes",
            "partially_supports",
            "background"
          ],
          "title": "Support Relation",
          "type": "string"
        },
        "verification_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "verified",
            "conflict",
            "unverifiable"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "reviewer": {
          "default": "",
          "title": "Reviewer",
          "type": "string"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "claim_id",
        "evidence_type",
        "support_relation"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "ResearchFinding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "limitations": {
          "default": "",
          "title": "Limitations",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "statement"
      ],
      "title": "ResearchFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured model output for the research stage.",
  "properties": {
    "research_question": {
      "minLength": 1,
      "title": "Research Question",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ResearchFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "source_conflicts": {
      "items": {
        "type": "string"
      },
      "title": "Source Conflicts",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "research_question",
    "scope",
    "claims"
  ],
  "title": "ResearchAnalysis",
  "type": "object"
}
