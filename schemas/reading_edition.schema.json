{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ReadingSection": {
      "additionalProperties": false,
      "properties": {
        "slide_id": {
          "pattern": "^slide-[0-9]{3,}$",
          "title": "Slide Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paragraphs",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "slide_id",
        "title",
        "paragraphs"
      ],
      "title": "ReadingSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "abstract": {
      "minLength": 1,
      "title": "Abstract",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReadingSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "references": {
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "title",
    "abstract",
    "sections"
  ],
  "title": "ReadingEdition",
  "type": "object"
}
