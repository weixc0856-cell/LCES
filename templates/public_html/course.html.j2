<!doctype html>
<html lang="{{ content.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ content.title }}</title>
<style>
:root{color-scheme:light;--ink:#232323;--muted:#666;--accent:#c05a1e;--line:#e6e1da;--bg:#fbfaf7;--panel:#fff}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.75 "Noto Serif SC","Source Han Serif SC","Songti SC",system-ui,serif}
a{color:var(--accent)}
.skip{position:absolute;left:-999px;top:0;background:#fff;padding:.5rem 1rem}
.skip:focus{left:1rem;z-index:10}
main{width:min(1080px,calc(100% - 48px));margin:auto;padding:56px 0 96px}
header.banner{border-bottom:2px solid var(--ink);padding-bottom:32px;margin-bottom:16px}
.eyebrow{color:var(--accent);font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px}
h1{font-size:clamp(2rem,4.6vw,3.4rem);line-height:1.18;margin:0 0 12px}
.subtitle{color:var(--muted);font-size:1.1rem;margin:0}
article{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:32px 36px;margin:28px 0;scroll-margin-top:24px}
article h2{font-size:clamp(1.35rem,2.6vw,2rem);line-height:1.3;margin:0 0 20px}
article p{max-width:74ch}
ul,ol{padding-left:1.4em}
li{margin:.35em 0}
blockquote{margin:1.2em 0;padding:.6em 1.2em;border-left:3px solid var(--accent);background:#fdf7f1;color:#3a3a3a}
.formula{display:block;overflow-x:auto;font-family:"Latin Modern Math","Cambria Math",serif;font-size:1.15rem;padding:1em;background:#f6f3ee;border-radius:8px}
.code{overflow-x:auto;background:#1f2328;color:#e6edf3;border-radius:10px;padding:16px 18px;font:14px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace}
.code-caption,.figure-caption,.table-caption{color:var(--muted);font-size:.9rem;margin-top:.5em}
figure{margin:1.4em 0}
figure img,figure svg,video{max-width:100%;height:auto;display:block}
video{background:#000;border-radius:8px;margin:1em 0}
table{border-collapse:collapse;width:100%;margin:1em 0;font-size:.95rem}
th,td{border:1px solid var(--line);padding:.55em .7em;text-align:left;vertical-align:top;overflow-wrap:anywhere}
th{background:#f3efe9}
.callout{border-radius:10px;padding:14px 18px;margin:1.2em 0;border:1px solid var(--line);background:#f7f5f1}
.callout.warning{border-color:#e0b25c;background:#fdf6e7}
.callout.limitation{border-color:#b9c9d8;background:#f1f6fa}
.callout.assumption{border-color:#cbb7d8;background:#f8f2fb}
.check{border:1px solid #c9d8c4;background:#f4f8f2;border-radius:10px;padding:14px 18px;margin:1.2em 0}
.check-question{margin:0 0 .5em}
.check details{margin-top:.4em}
.check summary{cursor:pointer;color:#3c5a34;font-weight:600}
.check-rationale{color:var(--muted);font-size:.92rem;margin:.4em 0 0}
.sources{color:var(--muted);font-size:.85rem;margin-top:24px;border-top:1px dashed var(--line);padding-top:12px}
footer{color:var(--muted);font-size:.85rem;border-top:1px solid var(--line);margin-top:48px;padding-top:20px}
@media (max-width:640px){body{font-size:17px}article{padding:22px 18px}main{width:calc(100% - 28px)}}
@media print{body{background:#fff}article{break-inside:avoid;border:1px solid #ddd}.skip{display:none}}
</style>
</head>
<body>
<a class="skip" href="#content">跳到正文</a>
<main id="content">
<header class="banner">
<p class="eyebrow">课程展示</p>
<h1>{{ content.title }}</h1>
{% if content.subtitle %}<p class="subtitle">{{ content.subtitle }}</p>{% endif %}
</header>
{% for slide in content.slides %}
<article id="{{ slide.slide_id }}">
<p class="eyebrow">第 {{ loop.index }} 节</p>
<h2>{{ slide.title }}</h2>
{% for block in slide.body %}
{% if block.type == "paragraph" %}
<p>{{ block.text }}</p>
{% elif block.type == "bullets" %}
<ul>{% for item in block["items"] %}<li>{{ item }}</li>{% endfor %}</ul>
{% elif block.type == "formula" %}
<div class="formula">{{ block.latex }}</div>
{% if block.explanation %}<p class="figure-caption">{{ block.explanation }}</p>{% endif %}
{% elif block.type == "code" %}
<pre class="code"><code>{{ block.code }}</code></pre>
{% if block.caption %}<p class="code-caption">{{ block.caption }}</p>{% endif %}
{% elif block.type == "figure" %}
{% if block.visual_html %}{{ block.visual_html | safe }}{% else %}
<figure>
<img src="{{ block.path }}" alt="{{ block.alt }}" loading="lazy">
{% if block.caption %}<figcaption class="figure-caption">{{ block.caption }}</figcaption>{% endif %}
</figure>
{% endif %}
{% elif block.type == "table" %}
{% if block.visual_html %}{{ block.visual_html | safe }}{% else %}
<table>
{% if block.caption %}<caption class="table-caption">{{ block.caption }}</caption>{% endif %}
<thead><tr>{% for column in block.columns %}<th scope="col">{{ column }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in block.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
</table>
{% endif %}
{% elif block.type == "chart" %}
{{ block.visual_html | safe }}
{% elif block.type == "diagram" %}
{{ block.visual_html | safe }}
{% elif block.type == "graph" %}
{{ block.visual_html | safe }}
{% elif block.type == "animation" %}
{% if block.video_rendered %}
<figure>
<video controls preload="metadata" aria-label="{{ block.alt }}">
<source src="{{ block.video_src }}" type="video/mp4">
{{ block.alt }}
</video>
{% if block.caption %}<figcaption class="figure-caption">{{ block.caption }}</figcaption>{% endif %}
</figure>
{% else %}
<p class="figure-caption">{{ block.alt }}</p>
{% endif %}
{% elif block.type == "callout" %}
<div class="callout {{ block.kind }}">{{ block.text }}</div>
{% elif block.type == "check" %}
<div class="check">
<p class="check-question"><strong>学习检查：</strong>{{ block.question }}</p>
<details><summary>查看参考答案</summary><p>{{ block.answer }}</p>{% if block.rationale %}<p class="check-rationale">{{ block.rationale }}</p>{% endif %}</details>
</div>
{% elif block.type == "quote" %}
<blockquote>{{ block.text }}{% if block.attribution %}<cite>— {{ block.attribution }}</cite>{% endif %}</blockquote>
{% endif %}
{% endfor %}
{% if slide.source_ids %}<p class="sources">来源：{{ slide.source_ids | join("、") }}</p>{% endif %}
</article>
{% endfor %}
<footer>本页由 LCES 从公开内容模型构建。</footer>
</main>
</body>
</html>
