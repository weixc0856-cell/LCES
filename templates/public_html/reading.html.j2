<!doctype html>
{% import "_blocks.j2" as blocks %}
<html lang="{{ edition.language | default('zh-CN', true) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ edition.title }} · 深度阅读版</title>
<style>
{% include "_theme.css" %}
.reading-shell{max-width:980px;margin:0 auto;padding:48px 24px 96px}
.reading-shell header.banner{border-bottom:2px solid var(--ink);padding-bottom:26px;margin-bottom:14px}
.reading-shell .eyebrow{font-family:var(--sans);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin:0 0 6px}
.reading-shell h1{font-size:clamp(2rem,4.4vw,3.1rem);line-height:1.18;margin:0 0 14px}
.abstract{background:#f1eae0;border-left:5px solid var(--accent);border-radius:0 8px 8px 0;padding:18px 22px;color:#3a322a}
.abstract h2{font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;margin:0 0 8px;font-family:var(--sans);color:var(--accent)}
.toc{margin:34px 0 10px;border:1px solid var(--line);border-radius:8px;padding:18px 22px;background:var(--panel)}
.toc h2{font-size:.82rem;letter-spacing:.14em;text-transform:uppercase;margin:0 0 10px;font-family:var(--sans);color:var(--muted)}
.toc ol{columns:2;column-gap:34px;margin:0;padding-left:1.2em;font-family:var(--sans);font-size:.92em}
.toc a{text-decoration:none}
.toc a:hover{text-decoration:underline}
.nomenclature{margin:30px 0}
.nomenclature table{font-size:.86em}
section.reading-section{padding-top:26px;margin-top:26px;border-top:1px solid var(--line)}
section.reading-section h2{font-size:1.55rem;line-height:1.3;margin:0 0 6px}
.section-kicker{font-family:var(--sans);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 6px}
.reading-section p{max-width:74ch}
.reading-section .cite{font-family:var(--sans);font-size:.8em;color:var(--muted);margin-top:18px;border-top:1px dashed var(--line);padding-top:8px}
.references{margin-top:48px}
.references h2{font-size:1.1rem}
footer.page-foot{max-width:none}
@media print{.toc{display:none}.reading-shell{padding:0}section.reading-section{break-inside:auto}}
</style>
</head>
<body>
<div class="reading-shell">
<header class="banner">
<p class="eyebrow">深度研究阅读版</p>
<h1>{{ edition.title }}</h1>
<div class="abstract">
<h2>摘要</h2>
<p>{{ edition.abstract }}</p>
</div>
</header>

<nav class="toc" aria-label="目录">
<h2>目录</h2>
<ol>{% for section in edition.sections %}<li><a href="#{{ section.slide_id }}">{{ section.title }}</a></li>{% endfor %}</ol>
</nav>

{% if edition.nomenclature %}
<section class="nomenclature" aria-label="符号与张量形状">
<div class="table-wrap">
<table>
<caption>符号、含义与张量形状（阅读时随时回查）</caption>
<thead><tr><th scope="col">符号</th><th scope="col">含义</th><th scope="col">形状 / 取值</th></tr></thead>
<tbody>
{% for entry in edition.nomenclature %}<tr><td><code>{{ entry.symbol }}</code></td><td>{{ entry.meaning }}</td><td>{% if entry.shape %}<code>{{ entry.shape }}</code>{% endif %}</td></tr>{% endfor %}
</tbody>
</table>
</div>
</section>
{% endif %}

{% for section in edition.sections %}
<section class="reading-section" id="{{ section.slide_id }}">
<p class="section-kicker">第 {{ loop.index }} 节 · 共 {{ edition.sections | length }} 节</p>
<h2>{{ section.title }}</h2>
{% if section.body %}
{{ blocks.render_blocks(section.body) }}
{% else %}
{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
{% endif %}
{% if section.source_ids %}<p class="cite">来源：{{ section.source_ids | join("、") }}</p>{% endif %}
</section>
{% endfor %}

{% if edition.references %}
<section class="references">
<h2>参考文献与来源</h2>
<ul>{% for reference in edition.references %}<li>{{ reference }}</li>{% endfor %}</ul>
</section>
{% endif %}

<footer class="page-foot">
<p>本页由 LCES 从阅读版内容模型构建。阅读版应比幻灯片更详细；如果两者信息量相同，是内容问题，不是渲染问题。</p>
</footer>
</div>
</body>
</html>
