# Copy this file to `.env` and fill in values. Never commit `.env`.
# Provider: mock | local | deepseek | anthropic
LCES_PROVIDER=local

# Local llama.cpp llama-server (OpenAI-compatible). Start D:\AI\start_server.bat first.
LCES_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# Empty means "discover the loaded model from /v1/models".
LCES_LOCAL_MODEL=
LCES_LOCAL_API_KEY=
LCES_LOCAL_JSON_MODE=true
LCES_LOCAL_TIMEOUT_SECONDS=300
LCES_LOCAL_MAX_RETRIES=2
# Local context is small; keep research prompts bounded. Tune after benchmarking.
LCES_LOCAL_PROMPT_CHAR_BUDGET=24000

# DeepSeek (OpenAI-compatible endpoint). DEEPSEEK_API_KEY is also accepted.
LCES_DEEPSEEK_API_KEY=
LCES_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LCES_DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude Messages API. ANTHROPIC_API_KEY is also accepted.
LCES_ANTHROPIC_API_KEY=
LCES_ANTHROPIC_BASE_URL=https://api.anthropic.com
LCES_ANTHROPIC_MODEL=claude-sonnet-4-5
LCES_ANTHROPIC_VERSION=2023-06-01

# Optional stage routing (research/outline/generate). Empty disables routing.
LCES_ROUTING_FILE=

# Request behaviour for cloud providers.
LCES_REQUEST_TIMEOUT_SECONDS=120
LCES_MAX_RETRIES=3
LCES_TEMPERATURE=0.2
LCES_MAX_OUTPUT_TOKENS=8192

# Local paths (relative to the working directory unless absolute).
LCES_PROJECTS_DIR=projects
LCES_DATABASE_PATH=var/lces.sqlite3
LCES_LOG_LEVEL=INFO

# Ingestion limits.
LCES_MAX_SOURCE_BYTES=50000000
LCES_PROMPT_CHAR_BUDGET=120000
