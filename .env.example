# Copy this file to `.env` and fill in values. Never commit `.env`.
# Provider: mock | deepseek | anthropic
LCES_PROVIDER=mock

# DeepSeek (OpenAI-compatible endpoint). Verify model IDs against official docs.
LCES_DEEPSEEK_API_KEY=
LCES_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LCES_DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude Messages API.
LCES_ANTHROPIC_API_KEY=
LCES_ANTHROPIC_BASE_URL=https://api.anthropic.com
LCES_ANTHROPIC_MODEL=claude-sonnet-4-5
LCES_ANTHROPIC_VERSION=2023-06-01

# Request behaviour.
LCES_REQUEST_TIMEOUT_SECONDS=120
LCES_MAX_RETRIES=3
LCES_TEMPERATURE=0.2
LCES_MAX_OUTPUT_TOKENS=8192

# Local paths (relative to the working directory unless absolute).
LCES_PROJECTS_DIR=projects
LCES_DATABASE_PATH=var/lces.sqlite3
LCES_LOG_LEVEL=INFO

# Ingestion limits.
LCES_MAX_SOURCE_BYTES=50000000
LCES_PROMPT_CHAR_BUDGET=120000
