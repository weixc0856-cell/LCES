# Copy this file to `.env` and fill in values. Never commit `.env`.
# Provider: mock | local | deepseek | anthropic
LCES_PROVIDER=local

# Local llama.cpp llama-server (OpenAI-compatible). Start D:\AI\start_server.bat first.
# Course development uses the SYCL backend and the "[3] CPU-MoE 48 layers @ 16K"
# profile with Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf; see docs/LOCAL_MODEL.md.
# Change this when you load a different model: a mismatch fails loudly instead
# of silently rendering with the wrong model. Empty means auto-discovery.
LCES_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LCES_LOCAL_MODEL=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M
LCES_LOCAL_API_KEY=
LCES_LOCAL_JSON_MODE=true
LCES_LOCAL_TIMEOUT_SECONDS=300
LCES_LOCAL_MAX_RETRIES=2
# Local context is small; keep research prompts bounded. With the 16K profile
# use 10000-12000; the default of 24000 assumes a larger context window.
LCES_LOCAL_PROMPT_CHAR_BUDGET=12000

# Gate 3 browser rendering checks (needs `uv sync --extra browser` and
# `uv run playwright install chromium`). Set to false to skip them; skipped
# checks report NOT_RUN, not PASS.
LCES_BROWSER_QA=true

# Optional: absolute path to the Graphviz `dot` executable. When empty, `dot`
# is looked up on PATH. A missing dot reports environment_unavailable; LCES
# never substitutes another renderer.
LCES_DOT_BIN=

# DeepSeek (OpenAI-compatible endpoint). DEEPSEEK_API_KEY and the legacy
# LCES_API_KEY are also accepted.
LCES_DEEPSEEK_API_KEY=
LCES_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LCES_DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude Messages API. ANTHROPIC_API_KEY is also accepted.
LCES_ANTHROPIC_API_KEY=
LCES_ANTHROPIC_BASE_URL=https://api.anthropic.com
LCES_ANTHROPIC_MODEL=claude-sonnet-4-5
LCES_ANTHROPIC_VERSION=2023-06-01

# Optional stage routing (research/outline/generate). Empty disables routing.
LCES_ROUTING_FILE=

# Request behaviour for cloud providers.
LCES_REQUEST_TIMEOUT_SECONDS=120
LCES_MAX_RETRIES=3
LCES_TEMPERATURE=0.2
LCES_MAX_OUTPUT_TOKENS=8192

# Local paths (relative to the working directory unless absolute).
LCES_PROJECTS_DIR=projects
LCES_DATABASE_PATH=var/lces.sqlite3
LCES_LOG_LEVEL=INFO

# Ingestion limits.
LCES_MAX_SOURCE_BYTES=50000000
LCES_PROMPT_CHAR_BUDGET=120000
